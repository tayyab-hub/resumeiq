# ---------------------------------------------------------------------------
# ResumeIQ frontend configuration
# Copy to .env.local for development.
#
# WARNING: every VITE_* variable is compiled into the browser bundle and is
# therefore public. Never put an API key or any secret in this file.
# ---------------------------------------------------------------------------

# Local development against the API running on port 8000.
# In production set this to the deployed API URL, including /api/v1.
VITE_API_BASE_URL=http://localhost:8000/api/v1
