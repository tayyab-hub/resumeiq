# ---------------------------------------------------------------------------
# ResumeIQ backend configuration
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Environment: development | production
ENVIRONMENT=development
DEBUG=true

# Database -------------------------------------------------------------------
# Local Docker Compose default. In production use the managed instance URL.
DATABASE_URL=postgresql+psycopg://resumeiq:resumeiq@localhost:5432/resumeiq

# Security -------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The application refuses to start in production if this is left at the default.
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# CORS -----------------------------------------------------------------------
# Comma-separated exact origins. Never "*" while credentials are enabled.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploads --------------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
MIN_EXTRACTED_CHARS=200

# Rate limits ----------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
REGISTER_MAX_PER_HOUR=10
ANALYSES_PER_DAY=20
AI_CALLS_PER_DAY=20

# AI provider (OPTIONAL) -----------------------------------------------------
# Leave AI_API_KEY empty to run without AI. The analysis still completes in
# full; responses carry ai_status="unavailable".
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_TIMEOUT_SECONDS=20
AI_MAX_TOKENS=8000
AI_EFFORT=medium
